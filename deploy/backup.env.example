# deploy/backup.env is normally written by deploy/install-backup.sh.
# To write it by hand: copy this file to deploy/backup.env (gitignored),
# fill in real values, and chmod 600. Loaded by notes-backup.service.
S3_BUCKET=my-notes-backup-bucket
S3_PREFIX=notes
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1

# Optional ntfy notification on failure (and on success with NTFY_ON_SUCCESS=1).
#NTFY_TOPIC=my-topic
#NTFY_URL=https://ntfy.sh
#NTFY_ON_SUCCESS=1
