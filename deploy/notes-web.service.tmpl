# Template for /etc/systemd/system/notes-web.service.
#
# This file is NOT installed verbatim: `make install` substitutes the
# @PLACEHOLDER@ values (repo path, mise Ruby path, service user) and writes
# the result to /etc/systemd/system. Never edit the installed unit by hand —
# change this template and re-run `make install-web`.

[Unit]
Description=Notes Web (Puma + Solid Queue)
After=network.target
Wants=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@WEB_DIR@
ExecStart=@WEB_DIR@/bin/thrust @WEB_DIR@/bin/rails server -e production
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5
SyslogIdentifier=notes-web

# Environment
Environment=PATH=@RUBY_DIR@/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RAILS_ENV=production
# Puma listens on PORT, loopback only (see config/puma.rb). Thruster listens
# on HTTP_PORT on all interfaces; the reverse proxy on the Caddy machine
# connects to it over Tailscale.
Environment=PORT=3001
Environment=TARGET_PORT=3001
Environment=HTTP_PORT=3002
Environment=SOLID_QUEUE_IN_PUMA=true
Environment=RAILS_LOG_LEVEL=info
Environment=PIDFILE=@WEB_DIR@/tmp/pids/server.pid
Environment=RUBY_YJIT_ENABLE=1
# All runtime secrets (APP_HOST, Google OAuth, optional RAILS_MASTER_KEY)
# live in the repo so they migrate with it.
EnvironmentFile=-@WEB_DIR@/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=@WEB_DIR@/storage
ReadWritePaths=@WEB_DIR@/log
ReadWritePaths=@WEB_DIR@/tmp

# Resource limits
LimitNOFILE=65536
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
